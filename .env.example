# Firefly III
FIREFLY_URL=http://192.168.1.2
FIREFLY_TOKEN=your-firefly-token

# Plaid
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ACCESS_TOKEN=access-sandbox-xxx

# OpenAI (for LLM categorization)
OPENAI_API_KEY=sk-proj-xxx

# Plaid account_id → Firefly account ID mapping
# Get Plaid account IDs from /accounts/get, Firefly IDs from /api/v1/accounts?type=asset
# Format: plaid_id_1:firefly_id_1,plaid_id_2:firefly_id_2,plaid_id_3:firefly_id_3
ACCOUNT_MAP=

# Firefly rule group ID for auto-categorization rules (default: 1)
RULE_GROUP_ID=1

# State persistence directory (default: ./data)
STATE_DIR=./data
